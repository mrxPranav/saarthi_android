<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".SaarthiApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Saarthi">

        <activity
            android:name=".LandingActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".SavedNotesActivity"
            android:label="Saved Notes"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".BackupActivity"
            android:label="Backup and Restore"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".SettingsActivity"
            android:label="Settings"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".UpdateTitleActivity"
            android:label="AI Update Titles"
            android:parentActivityName=".LandingActivity" />

        <activity
            android:name=".AddTaskActivity"
            android:label="Add Task"
            android:parentActivityName=".LandingActivity" />

        <activity
            android:name=".TasksListActivity"
            android:label="Tasks List"
            android:parentActivityName=".LandingActivity" />

        <activity
            android:name=".EditTaskActivity"
            android:label="Edit Task"
            android:parentActivityName=".TasksListActivity" />

        <activity
            android:name=".HealthCheckActivity"
            android:label="Server Health Stats"
            android:parentActivityName=".LandingActivity" />

        <activity
            android:name=".ViewNoteActivity"
            android:label="View Note"
            android:parentActivityName=".SavedNotesActivity" />

    </application>


</manifest>